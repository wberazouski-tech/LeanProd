FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY LeanProd.sln ./
COPY LeanProd.Domain/LeanProd.Domain.csproj LeanProd.Domain/
COPY LeanProd.Application/LeanProd.Application.csproj LeanProd.Application/
COPY LeanProd.Infrastructure/LeanProd.Infrastructure.csproj LeanProd.Infrastructure/
COPY LeanProd.Api/LeanProd.Api.csproj LeanProd.Api/
RUN dotnet restore LeanProd.Api/LeanProd.Api.csproj
COPY LeanProd.Domain/ LeanProd.Domain/
COPY LeanProd.Application/ LeanProd.Application/
COPY LeanProd.Infrastructure/ LeanProd.Infrastructure/
COPY LeanProd.Api/ LeanProd.Api/
RUN dotnet publish LeanProd.Api/LeanProd.Api.csproj -c Release --no-restore -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/publish .
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "LeanProd.Api.dll"]
