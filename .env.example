# Copy values into local user-secrets or your deployment secret store. Do not commit real values.
JWT_SIGNING_KEY=replace-with-at-least-64-random-characters
MSSQL_SA_PASSWORD=replace-with-a-strong-SQL-Server-password
BOOTSTRAP_ADMIN_EMAIL=admin@leanprod.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Production/staging example. Supply real credentials through a secret store.
Database__Provider=SqlServer
ConnectionStrings__DefaultConnection=Server=sql-host;Database=LeanProd;User Id=leanprod_app;Password=replace-me;Encrypt=True;TrustServerCertificate=False

# Demo/integration tests may override the provider:
# Database__Provider=Sqlite
# ConnectionStrings__DefaultConnection=Data Source=lean-prod.demo.db
